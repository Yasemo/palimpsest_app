{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write --watch server/main.ts",
    "start": "deno run --allow-net --allow-read --allow-env --allow-write server/main.ts",
    "db:setup": "deno run --allow-net --allow-read --allow-env server/db/setup.ts",
    "db:migrate": "deno run --allow-net --allow-read --allow-env server/db/migrate.ts"
  },
  "imports": {
    "std/": "https://deno.land/std@0.208.0/",
    "@neon/serverless": "jsr:@neon/serverless@^0.10.1"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  }
}
